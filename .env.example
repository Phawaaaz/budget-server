DATABASE_URL=postgresql://user:password@localhost:5432/budget_server
PORT=3000

# Gmail OAuth (Google Cloud Console -> APIs & Services -> Credentials).
# Redirect URI must exactly match one registered on the OAuth client, and
# should point at GET /api/sync/google/callback on this server's public URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/sync/google/callback
